# SlotKeeper backend environment template.
# Copy to .env and fill real values, or run scripts/gen-secrets.sh to generate them.
# Never commit the real .env file.

# Spring profile for the backend: dev or prod
SPRING_PROFILES_ACTIVE=dev

# Public base URL used inside customer message links
APP_BASE_URL=https://slotkeeper.example.com

# Origin of the frontend, used for the CORS allowlist
FRONTEND_ORIGIN=http://localhost:5173

# JDBC URL for the Postgres database
DB_URL=jdbc:postgresql://db:5432/slotkeeper

# Postgres user used only by Flyway migrations (DDL)
DB_MIGRATION_USER=slotkeeper_migrate

# Password for the migration user
DB_MIGRATION_PASSWORD=__PLACEHOLDER__

# Postgres user used by the app at runtime (CRUD only, no DDL)
DB_APP_USER=slotkeeper_app

# Password for the runtime app user
DB_APP_PASSWORD=__PLACEHOLDER__

# Username of the single owner account for dashboard login
ADMIN_USERNAME=owner

# BCrypt hash (strength 12) of the owner password, never the password itself
ADMIN_PASSWORD_HASH=__PLACEHOLDER__

# Base64 encoded 32 byte key for AES-256-GCM encryption of customer name and phone
ENCRYPTION_KEY=__PLACEHOLDER__

# Base64 encoded 32 byte key for HMAC-SHA256 phone hash used for lookups
PHONE_HMAC_KEY=__PLACEHOLDER__

# Message provider: console (default, logs masked entries) or twilio
MESSAGING_PROVIDER=console

# Twilio account SID, only needed when MESSAGING_PROVIDER=twilio
TWILIO_ACCOUNT_SID=__PLACEHOLDER__

# Twilio auth token, only needed when MESSAGING_PROVIDER=twilio
TWILIO_AUTH_TOKEN=__PLACEHOLDER__

# Twilio sender number, only needed when MESSAGING_PROVIDER=twilio
TWILIO_FROM=+15005550006
